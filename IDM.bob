<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <widget type="action_button" version="3.0.0">
    <name>Action Button_4</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>IDM_Top.bob</file>
        <macros>
          <prefix>TS16K-MO-</prefix>
          <suff1>0</suff1>
          <idname>HPMU-K16</idname>
          <dom>TS16K</dom>
          <pmac>192.168.116.1</pmac>
          <server>hpmu-k16</server>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>Open Main Screen</text>
    <x>40</x>
    <y>20</y>
    <width>140</width>
    <height>50</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_5</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>motor-button.bob</file>
        <target>tab</target>
      </action>
    </actions>
    <text>Motor Screens</text>
    <x>40</x>
    <y>90</y>
    <width>140</width>
    <height>50</height>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
