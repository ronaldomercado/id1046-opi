  <widget type="action_button" version="3.0.0">
    <name>EDM Exit Button</name>
    <actions>
      <action type="execute">
        <description>Execute Script</description>
        <script file="EmbeddedJs">
          <text><![CDATA[importPackage(Packages.org.csstudio.opibuilder.scriptUtil);ScriptUtil.closeAssociatedOPI(widget);]]></text>
        </script>
      </action>
    </actions>
    <text>Exit</text>
    <x>600</x>
    <y>552</y>
    <width>97</width>
    <height>25</height>
    <font>
      <font family="liberation sans" style="REGULAR" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color name="Exit: FG" red="192" green="0" blue="192">
      </color>
    </foreground_color>
    <background_color>
      <color name="Controller: BG" red="205" green="205" blue="205">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
